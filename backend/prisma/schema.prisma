datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  text      String
  date      String
  terms     String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
